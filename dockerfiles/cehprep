# CEH-Prep custom WebVM disk image — based on debian_mini.
# Build via the upstream Deploy workflow with DOCKERFILE_PATH=dockerfiles/cehprep.
# Keep total ext2 under 950M for GitHub Pages.

FROM --platform=linux/386 i386/debian:bookworm
ARG DEBIAN_FRONTEND=noninteractive

# 1. Core toolchain. Dropped from upstream debian_mini for ext2 budget:
#      ruby (~30 MB), nodejs (~80 MB), luajit/lua5.4 (~10 MB) — none used
#      by our drills. Re-add later if a drill genuinely needs them.
#    python3-cryptography + python3-impacket come from apt because i386 has
#    no prebuilt wheels for the newer PyPI versions and rustup doesn't
#    support i386-unknown-linux-gnu.
RUN apt-get clean && apt-get update && apt-get -y upgrade && \
    apt-get -y install --no-install-recommends \
        ca-certificates curl wget \
        bash-completion sudo less file vim nano tmux git jq xxd \
        gcc make python3 python3-pip \
        python3-cryptography python3-impacket \
        python3-requests python3-bs4 python3-lxml \
        unzip patch \
        dialog netcat-openbsd \
        openssl gnupg \
        cowsay

# 2. Pentest CLI tooling for CEH drills.
#    Picked for HTTP/script-level fitness inside WebVM (no raw sockets).
#    Dropped from earlier draft to fit the 900 M ext2 budget:
#      • nikto    — only in `contrib` on bookworm
#      • radare2  — amd64-only in bookworm; gdb covers basic RE
#      • tshark   — ~150 MB (wireshark-common). Re-add when we need pcap drills.
#      • hashcat  — ~100 MB. john alone covers the crypto drills for now.
#      • binwalk  — ~80 MB scipy deps. file/strings/xxd cover MVP file-analysis.
#      • exiftool, ent, wfuzz — modest size but unused so far.
RUN apt-get -y install --no-install-recommends \
        nmap \
        sqlmap \
        hydra \
        john \
        dirb \
        whois dnsutils \
        gdb strace ltrace

# 3. Lightweight Go HTTP tools — apt for gobuster, release tarball for ffuf.
RUN apt-get -y install --no-install-recommends gobuster || true
RUN curl -fsSL -o /tmp/ffuf.tgz \
      "https://github.com/ffuf/ffuf/releases/download/v2.1.0/ffuf_2.1.0_linux_386.tar.gz" \
    && tar -xzf /tmp/ffuf.tgz -C /usr/local/bin/ ffuf \
    && rm /tmp/ffuf.tgz && chmod +x /usr/local/bin/ffuf

# 4. Python pentest libs.
#    All deps now come from apt (see section 1) so this layer is intentionally
#    empty for now. pwntools is dropped — its paramiko dep drags newer
#    cryptography that wants a Rust toolchain unsupported on i386.
#    Re-add later as a `pip install --no-deps pwntools` if needed.

# 5. Aggressive size trim — apt caches, docs, locales, man pages.
#    Combined these save ~150 MB on top of the package cuts above.
RUN apt-get clean && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/* /var/log/* /tmp/* /root/.cache && \
    find /usr/share/doc -depth -mindepth 1 -delete && \
    find /usr/share/man -depth -mindepth 1 -delete && \
    find /usr/share/info -depth -mindepth 1 -delete && \
    find /usr/share/locale -mindepth 1 -maxdepth 1 \
         -not -name 'en*' -not -name 'C*' -not -name 'locale.alias' \
         -exec rm -rf {} +

# 6. Default user. No passwords are set — this is a single-user, per-browser-tab
#    sandbox; root sessions are fine without auth, and `user` gets passwordless
#    sudo when needed. Hardcoding a password here adds zero security and trips
#    secret scanners.
RUN useradd -m user && \
    echo "user ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/user && \
    chmod 0440 /etc/sudoers.d/user

# 7. CEH-Prep drill scaffold (the bread and butter of this image).
COPY --chown=user:user ./cehprep /home/user/cehprep
RUN ln -s /home/user/cehprep/bin/drill /usr/local/bin/drill && \
    chmod +x /home/user/cehprep/bin/drill && \
    find /home/user/cehprep/drills -name check -exec chmod +x {} + && \
    find /home/user/cehprep/drills -name setup.sh -exec chmod +x {} +

# 8. Welcome banner (replaces upstream Welcome.txt for first-boot motd).
RUN echo 'cat /home/user/cehprep/docs/Welcome.txt 2>/dev/null' >> /home/user/.bashrc && \
    echo 'echo "Tip: type \`drill list\` to see available drills."' >> /home/user/.bashrc

WORKDIR /home/user
ENV HOME="/home/user" TERM="xterm" USER="user" SHELL="/bin/bash" EDITOR="vim" LANG="en_US.UTF-8" LC_ALL="C"
CMD ["/bin/bash"]
