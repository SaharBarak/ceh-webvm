#!/usr/bin/env bash
# Grade nmap-flags drill: normalize each user answer (sort flags), compare
# against any acceptable form. Order-insensitive within a single command,
# but the answers must be in the same order as the questions.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"

[ -f "$HERE/answers.txt" ] || { echo "missing answers.txt"; exit 1; }
[ -f "$HERE/.answers" ]    || { echo "drill state corrupt — re-run: drill start day03 01"; exit 2; }

normalize() {
  # Drop leading comments + blank lines; collapse whitespace; sort tokens
  # within a single line so flag order doesn't matter.
  python3 - "$1" <<'PY'
import sys, shlex
path = sys.argv[1]
out = []
for raw in open(path):
    s = raw.strip()
    if not s or s.startswith('#'): continue
    try:
        toks = shlex.split(s)
    except ValueError:
        toks = s.split()
    out.append(' '.join(sorted(toks)))
print('\n'.join(out))
PY
}

user_norm=$(normalize "$HERE/answers.txt")
mapfile -t user_lines <<< "$user_norm"

# Acceptable forms file: each line is one question, multiple acceptable forms
# separated by ||
mapfile -t accepted < "$HERE/.answers"

if [ "${#user_lines[@]}" -ne "${#accepted[@]}" ]; then
  echo "expected ${#accepted[@]} answers, got ${#user_lines[@]} — leave one command per question, in order"
  exit 1
fi

fail=0
for i in "${!accepted[@]}"; do
  IFS='|' read -ra forms <<< "${accepted[$i]//||/|}"
  ok=0
  for form in "${forms[@]}"; do
    [ -z "$form" ] && continue
    norm_form=$(python3 -c "import shlex,sys; print(' '.join(sorted(shlex.split(sys.argv[1]))))" "$form")
    if [ "${user_lines[$i]}" = "$norm_form" ]; then ok=1; break; fi
  done
  if [ "$ok" -ne 1 ]; then
    echo "Q$((i+1)) wrong:  got '${user_lines[$i]}'"
    fail=1
  fi
done

[ "$fail" -eq 0 ]
